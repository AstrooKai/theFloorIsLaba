# ========================================================
# 1. LOCALHOST SETUP (For Live Presentation & Development)
# Keep this in your local .env file
# ========================================================
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=laundry_shop_db

# ========================================================
# 2. VERCEL & CLOUD DATABASE SETUP (Optional for Cloud)
# Add these in Vercel Project Settings -> Environment Variables
# Or put in .env.cloud to run: npm run db:cloud:seed
# ========================================================
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=your_cloud_user
# DB_PASSWORD=your_cloud_password
# DB_NAME=laundry_shop_db
# DB_SSL=true

# OR use a single connection string:
# DATABASE_URL=mysql://user:pass@host:4000/laundry_shop_db?ssl={"rejectUnauthorized":false}
